#!/opt/homebrew/bin/python3
"""Print exactly one configured provider key for Codex's auth command."""

from __future__ import annotations

import json
import os
from pathlib import Path
import sys


CODEX_HOME = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))).expanduser()
CREDENTIALS_PATH = CODEX_HOME / "provider-credentials.json"
STATE_PATH = CODEX_HOME / "provider-model-state.json"


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("Укажите провайдера.")
    provider_id = sys.argv[1]
    credential_id = "openrouter" if provider_id == "openrouter-all" else provider_id
    try:
        state = json.loads(STATE_PATH.read_text(encoding="utf-8"))
        for provider in state.get("providers", []) if isinstance(state, dict) else []:
            if isinstance(provider, dict) and provider.get("id") == provider_id:
                credential_id = str(provider.get("credential_id", credential_id))
                break
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        pass
    try:
        credentials = json.loads(CREDENTIALS_PATH.read_text(encoding="utf-8"))
        key = credentials[credential_id]
    except (FileNotFoundError, KeyError, json.JSONDecodeError) as error:
        raise SystemExit("Ключ провайдера не настроен.") from error
    if not isinstance(key, str) or not key.strip():
        raise SystemExit("Ключ провайдера пустой.")
    sys.stdout.write(key.strip())


if __name__ == "__main__":
    main()
