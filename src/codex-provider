def command_provider_add(args: argparse.Namespace) -> None:
    api_key = sys.stdin.read().strip() if args.api_key_stdin else ""
    if not api_key:
        raise SystemExit("Ключ провайдера не передан.")

    label = args.label.strip()
    prefix = args.prefix.strip().lower()
    base_url = args.base_url.strip().rstrip("/")
    if not label:
        raise SystemExit("Введите название провайдера.")
    import re
    if not re.fullmatch(r"[a-z][a-z0-9_-]{1,15}", prefix):
        raise SystemExit("Префикс должен быть от 2 до 16 символов: латиница, цифры, - или _, и начинаться с буквы.")
    if not base_url.startswith(("http://", "https://")):
        raise SystemExit("Адрес API должен начинаться с http:// или https://.")

    state = load_state(MODEL_STATE_PATH)
    definitions = provider_definitions(state)
    if prefix in definitions:
        raise SystemExit(f"Префикс {prefix} уже занят.")
    definition = {
        "id": prefix,
        "label": label,
        "base_url": base_url,
        "models_url": args.models_url.strip() or None,
        "credential_id": prefix,
        "alias": prefix,
        "built_in": False,
    }
    models_url = definition.get("models_url") or f"{base_url}/models"
    probe = dict(definition)
    probe["models_url"] = models_url
    credentials = load_credentials() if CREDENTIALS_PATH.exists() else {}
    try:
        fetch_models(prefix, probe, api_key, MODEL_CACHE_PATH, cache_id=f"probe-{prefix}")
    except RuntimeError as error:
        raise SystemExit(f"Провайдер не добавлен: список моделей не загрузился ({error}).")

    credentials[definition["credential_id"]] = api_key
    save_credentials(credentials)
    records = state.setdefault("providers", [])
    if not isinstance(records, list):
        state["providers"] = records = []
    records = [item for item in records if not isinstance(item, dict) or item.get("id") != prefix]
    records.append(definition)
    state["providers"] = records
    save_state(MODEL_STATE_PATH, state)
    refresh_provider_registry(state)
    print(f"Провайдер {label} добавлен. Список моделей загружен.")


def command_provider_remove(args: argparse.Namespace) -> None:
    state = load_state(MODEL_STATE_PATH)
    definitions = provider_definitions(state)
    provider = definitions.get(args.provider)
    if provider is None:
        raise SystemExit("Провайдер не найден.")
    if provider.get("built_in"):
        raise SystemExit("Встроенного провайдера OpenRouter удалить нельзя.")
    state["providers"] = [
        item for item in state.get("providers", [])
        if not isinstance(item, dict) or item.get("id") != args.provider
    ]
    state["selected_models"] = [
        item for item in state.get("selected_models", [])
        if not isinstance(item, dict) or item.get("provider_id") != args.provider
    ]
    if isinstance(state.get("compaction_model"), dict) and state["compaction_model"].get("provider_id") == args.provider:
        state["compaction_model"] = None
    save_state(MODEL_STATE_PATH, state)
    credentials = load_credentials() if CREDENTIALS_PATH.exists() else {}
    credential_id = str(provider.get("credential_id", args.provider))
    if credential_id in credentials:
        credentials.pop(credential_id)
        save_credentials(credentials)
    print(f"Провайдер {provider['label']} удалён.")


