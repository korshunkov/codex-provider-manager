    if args.search:
        visible = search_models(models, args.search, limit=args.limit)
    elif args.format == "json":
        visible = models
    else:
        visible = build_shelf(provider_id, PROVIDERS[provider_id], models, state, selected["id"])
        visible = visible[: args.limit]
    favorites = set(state["favorites"].get(provider_id, []))
    if args.format == "json":
        print(json.dumps({
            "provider": provider_id,
            "label": PROVIDERS[provider_id]["label"],
