def toml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def table_header(line: str) -> str | None:
    stripped = line.strip()
    if not (stripped.startswith("[") and stripped.endswith("]")):
        return None
    return stripped.strip("[]").replace('"', "").replace("'", "").replace(" ", "")


def is_provider_table(header: str | None) -> bool:
    if header is None:
        return False
    return any(header == f"model_providers.{name}" or header.startswith(f"model_providers.{name}.") for name in PROVIDERS)


def remove_managed_provider_blocks(text: str) -> str:
    kept: list[str] = []
    skipping = False
    for line in text.splitlines(keepends=True):
        header = table_header(line)
        if header is not None:
            skipping = is_provider_table(header)
        if not skipping:
            kept.append(line)
    return "".join(kept).rstrip() + "\n"


def provider_block(target_id: str) -> str:
    if target_id == PROXY_TARGET_ID:
        return "\n".join(
            [
                f"[model_providers.{SESSION_PROVIDER_ID}]",
                f"name = {toml_string(DISPLAY_NAME)}",
                f"base_url = {toml_string(PROXY_BASE_URL)}",
                'wire_api = "responses"',
                "supports_websockets = false",
            ]
        )
    provider = PROVIDERS[target_id]
    lines = [
        f"[model_providers.{SESSION_PROVIDER_ID}]",
        f"name = {toml_string(DISPLAY_NAME)}",
        f"base_url = {toml_string(provider['base_url'])}",
        'wire_api = "responses"',
    ]
    if provider["supports_websockets"]:
        lines.append("supports_websockets = true")
    else:
        lines.append("supports_websockets = false")
    if target_id == SESSION_PROVIDER_ID:
        # Match Codex Sale's own installer: it authenticates through auth.json.
        lines.extend(
            [
                'env_key = "CODEX_LB_API_KEY"',
                "requires_openai_auth = true",
            ]
        )
    else:
        lines.extend(
            [
                "",
                f"[model_providers.{SESSION_PROVIDER_ID}.auth]",
                f"command = {toml_string(str(KEY_HELPER))}",
                f"args = [{toml_string(target_id)}]",
            ]
        )
    return "\n".join(lines)


def active_service(config: dict) -> str:
    """Return the selected upstream service, even with the stable session ID."""
    providers = config.get("model_providers", {})
    if isinstance(providers, dict):
        stable_provider = providers.get(SESSION_PROVIDER_ID, {})
        if isinstance(stable_provider, dict):
            auth = stable_provider.get("auth", {})
            args = auth.get("args", []) if isinstance(auth, dict) else []
            if args and args[0] in PROVIDERS:
                return args[0]
            base_url = stable_provider.get("base_url")
            if base_url == PROXY_BASE_URL:
                return PROXY_TARGET_ID
            for provider_id, provider in PROVIDERS.items():
                if provider["base_url"] == base_url:
                    return provider_id

    configured_id = config.get("model_provider")
    if configured_id in PROVIDERS:
        return configured_id
    return SESSION_PROVIDER_ID


def configured_proxy_text(text: str) -> str:
    base = remove_managed_provider_blocks(text)
    base = update_top_level(base, {"model_provider": SESSION_PROVIDER_ID})
    return base.rstrip() + "\n\n" + provider_block(PROXY_TARGET_ID) + "\n"


def configured_text(text: str, target_id: str | None = None) -> str:
    if target_id is None:
        try:
            target_id = active_service(tomllib.loads(text))
        except tomllib.TOMLDecodeError:
            target_id = SESSION_PROVIDER_ID
    if target_id not in PROVIDERS:
        raise SystemExit(f"Неизвестный сервис: {target_id}")
    base = remove_managed_provider_blocks(text)
    base = update_top_level(base, {"model_provider": SESSION_PROVIDER_ID})
    return base.rstrip() + "\n\n" + provider_block(target_id) + "\n"


def update_top_level(text: str, values: dict[str, str]) -> str:
    lines = text.splitlines(keepends=True)
    first_table = next((index for index, line in enumerate(lines) if table_header(line) is not None), len(lines))
    prefix = lines[:first_table]
    suffix = lines[first_table:]
    found: set[str] = set()

    for index, line in enumerate(prefix):
        for key, value in values.items():
            if re.match(rf"^\s*{re.escape(key)}\s*=", line):
                ending = "\n" if line.endswith("\n") else ""
                prefix[index] = f"{key} = {toml_string(value)}{ending}"
                found.add(key)
                break

    missing = [key for key in values if key not in found]
    if missing:
        if prefix and prefix[-1].strip():
            prefix.append("\n")
        prefix.extend(f"{key} = {toml_string(values[key])}\n" for key in missing)
        if suffix and prefix[-1].strip():
            prefix.append("\n")
    return "".join(prefix + suffix)


def validate_toml(text: str) -> None:
    try:
        tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        raise SystemExit(f"Не меняю настройки: итоговый config.toml не проходит проверку ({error}).") from error


def create_backup() -> Path:
    BACKUPS_PATH.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    target = BACKUPS_PATH / f"before-codex-provider-cli-{stamp}"
    target.mkdir(mode=0o700)
    if CONFIG_PATH.exists():
        shutil.copy2(CONFIG_PATH, target / "config.toml")
    return target


def write_config(text: str, *, backup: bool) -> Path | None:
    validate_toml(text)
    backup_path = create_backup() if backup else None
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix="config.toml.", dir=CONFIG_PATH.parent)
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(text)
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, CONFIG_PATH)
    finally:
        if temporary_path.exists():
            temporary_path.unlink()
    return backup_path


def write_codex_sale_auth(api_key: str, backup_path: Path) -> None:
    """Store the active Codex Sale key in the auth file its proxy expects."""
    if AUTH_PATH.exists():
        shutil.copy2(AUTH_PATH, backup_path / "auth.json")
    descriptor, temporary_name = tempfile.mkstemp(prefix="auth.json.", dir=AUTH_PATH.parent)
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump({"auth_mode": "apikey", "OPENAI_API_KEY": api_key}, output, indent=2)
            output.write("\n")
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, AUTH_PATH)
    finally:
        if temporary_path.exists():
            temporary_path.unlink()


def ensure_provider_definitions(*, backup: bool) -> Path | None:
    if not CONFIG_PATH.exists():
        raise SystemExit(f"Не найден основной файл настроек: {CONFIG_PATH}")
    current = CONFIG_PATH.read_text(encoding="utf-8")
    updated = configured_text(current)
    if updated == current:
        return None
    return write_config(updated, backup=backup)


def load_config() -> dict:
    if not CONFIG_PATH.exists():
        raise SystemExit(f"Не найден основной файл настроек: {CONFIG_PATH}")
    try:
        return tomllib.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except tomllib.TOMLDecodeError as error:
        raise SystemExit(f"Не могу прочитать config.toml: {error}") from error


def load_credentials() -> dict[str, str]:
    try:
        data = json.loads(CREDENTIALS_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError as error:
        raise SystemExit("Не найден файл ключей. Выполните: codex-provider set-key <провайдер>") from error
    except json.JSONDecodeError as error:
        raise SystemExit(f"Файл ключей повреждён: {error}") from error
    return {key: value for key, value in data.items() if isinstance(value, str)}


def save_credentials(credentials: dict[str, str]) -> None:
    CREDENTIALS_PATH.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix="provider-credentials.", dir=CREDENTIALS_PATH.parent)
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(credentials, output, ensure_ascii=False, indent=2)
            output.write("\n")
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, CREDENTIALS_PATH)
    finally:
        if temporary_path.exists():
            temporary_path.unlink()


def refresh_provider_registry(state: dict) -> None:
    """Make persisted user providers visible to the current CLI process."""
    global PROVIDERS
    merged = dict(DEFAULT_PROVIDERS)
    for provider_id, definition in provider_definitions(state).items():
        previous = merged.get(provider_id, {})
        merged[provider_id] = {
            **definition,
            "model": previous.get("model", ""),
            "reasoning": previous.get("reasoning", "medium"),
            "supports_websockets": previous.get("supports_websockets", False),
        }
    PROVIDERS = merged


def available_models(provider_id: str, *, force: bool = False) -> list[dict]:
    state = load_state(MODEL_STATE_PATH)
    provider = provider_definition(provider_id, state) or PROVIDERS[provider_id]
    credentials = load_credentials()
    credential_id = str(provider.get("credential_id", provider_id))
    try:
        models = fetch_models(
            provider_id,
            provider,
            credentials.get(credential_id),
            MODEL_CACHE_PATH,
            force=force,
        )
        if provider_id != "openrouter-all":
            # OpenRouter is metadata only. It never changes the endpoint or
            # price of the selected gateway.
            reference_provider = provider_definition("openrouter-all", state) or PROVIDERS["openrouter-all"]
            try:
                reference_models = fetch_models(
                    "openrouter-reference",
                    reference_provider,
                    credentials.get("openrouter"),
                    MODEL_CACHE_PATH,
                    force=force,
                    cache_id="openrouter-reference",
                )
                models = merge_context_window_from_reference(models, reference_models)
                models = merge_reasoning_from_reference(models, reference_models)
                models = merge_artificial_analysis_from_reference(models, reference_models)
            except RuntimeError:
                pass
        if provider_id == "a6api":
            try:
                estimates = load_a6_marketplace_estimates(MODEL_CACHE_PATH, force=force)
                models = merge_a6_marketplace_prices(models, estimates)
            except RuntimeError:
                pass
        return models
    except RuntimeError as error:
        raise SystemExit(f"Список моделей {provider.get('label', provider_id)} недоступен: {error}")


def choose_model_for_provider(
    provider_id: str,
    models: list[dict],
    state: dict,
    current_model: str | None,
    requested_model: str | None,
) -> dict:
    if requested_model:
        selected = find_model(models, requested_model)
        if selected is None:
            raise SystemExit(f"Модель {requested_model} не найдена у провайдера {provider_id}.")
        return selected
    selected = find_model(models, current_model)
    if selected is not None:
        return selected
    selected = find_model(models, state["last_model"].get(provider_id))
    if selected is not None:
        return selected
    selected = find_model(models, PROVIDERS[provider_id]["model"])
    return selected or models[0]


def external_proxy_entry(entry: dict[str, str], state: dict | None = None) -> dict[str, str]:
    providers = provider_definitions(state)
    return {
        "provider_id": entry["provider_id"],
        "model_id": entry["model_id"],
        "proxy_id": proxy_model_id(entry["provider_id"], entry["model_id"], providers),
    }


def proxy_entries(state: dict) -> list[dict[str, str]]:
    return [external_proxy_entry(item, state) for item in proxy_selections(state)]


def find_current_proxy_entry(
    state: dict, selections: list[dict[str, str]], current_model: str | None
) -> dict[str, str] | None:
    if not isinstance(current_model, str):
        return None
    providers = provider_definitions(state)
    return next(
        (
            item
            for item in selections
            if proxy_model_id(item["provider_id"], item["model_id"], providers) == current_model
        ),
        None,
    )


def load_models_for_proxy_entries(entries: list[dict[str, str]]) -> dict[str, list[dict]]:
    models_by_provider: dict[str, list[dict]] = {}
    required_providers = {
        entry["provider_id"]
        for entry in entries
        if entry.get("provider_id") in PROVIDERS
    }
    for provider_id in sorted(required_providers):
        models_by_provider[provider_id] = available_models(provider_id)
    return models_by_provider


def rebuild_proxy_catalog(
    state: dict,
    models_by_provider: dict[str, list[dict]],
    active: dict[str, str] | None,
) -> list[dict]:
    if not CODEX_BINARY.exists():
        raise SystemExit(f"Не найден исполняемый файл Codex: {CODEX_BINARY}")
    shelf = build_proxy_shelf(
        state,
        models_by_provider,
        active,
        compaction_selection(state),
    )
    try:
        write_codex_catalog(MODEL_CATALOG_PATH, shelf, CODEX_BINARY, "proxy", state)
    except (RuntimeError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        raise SystemExit(f"Не удалось создать каталог моделей Codex: {error}") from error
    return shelf


def apply_proxy_configuration(
    state: dict,
    selections: list[dict[str, str]],
    active: dict[str, str] | None = None,
    compaction: dict[str, str] | None | object = ...,
) -> tuple[list[dict], str]:
    if not selections:
        raise SystemExit("Выберите хотя бы одну модель для прокси.")

    metadata_entries = list(selections)
    if active:
        metadata_entries.append(active)
    if compaction is not ... and compaction is not None:
        metadata_entries.append(compaction)
    models_by_provider = load_models_for_proxy_entries(metadata_entries)
    valid: list[dict[str, str]] = []
    for entry in selections:
        provider_id = entry.get("provider_id", "")
        model_id = entry.get("model_id", "")
        if provider_id not in PROVIDERS:
            raise SystemExit(f"Неизвестный провайдер: {provider_id}")
        model = find_model(models_by_provider[provider_id], model_id)
        if model is None:
            raise SystemExit(f"Модель {model_id} не найдена у провайдера {provider_id}.")
        key = selection_key(provider_id, model["id"])
        if not any(selection_key(item["provider_id"], item["model_id"]) == key for item in valid):
            valid.append({"provider_id": provider_id, "model_id": model["id"]})

    current_config = load_config()
    if active is None:
        active = find_current_proxy_entry(
            state, valid, current_config.get("model")
        ) or valid[0]
    else:
        active_model = find_model(models_by_provider[active["provider_id"]], active["model_id"])
        if active_model is None:
            raise SystemExit(
                f"Модель {active['model_id']} не найдена у провайдера {active['provider_id']}."
            )
        active = {"provider_id": active["provider_id"], "model_id": active_model["id"]}

    if compaction is not ...:
        if compaction is None:
            set_compaction_model(state, None, None)
        else:
            compaction_model = find_model(
                models_by_provider[compaction["provider_id"]], compaction["model_id"]
            )
            if compaction_model is None:
                raise SystemExit(
                    f"Модель компакта {compaction['model_id']} недоступна у "
                    f"провайдера {compaction['provider_id']}."
                )
            set_compaction_model(
                state, compaction["provider_id"], compaction_model["id"]
            )

    state["selected_models"] = valid
    shelf = rebuild_proxy_catalog(state, models_by_provider, active)
    represented = {model["id"] for model in shelf}
    warnings = [
        f"{entry['model_id']} не попала в каталог Codex: достигнут лимит {len(shelf)}."
        for entry in valid
        if proxy_model_id(entry["provider_id"], entry["model_id"], provider_definitions(state)) not in represented
    ]

    providers = provider_definitions(state)
    active_proxy_id = proxy_model_id(active["provider_id"], active["model_id"], providers)
    active_model = find_model(models_by_provider[active["provider_id"]], active["model_id"])
    assert active_model is not None
    current = CONFIG_PATH.read_text(encoding="utf-8")
    current_effort = current_config.get("model_reasoning_effort")
    if current_effort not in active_model["reasoning_levels"]:
        current_effort = active_model["default_reasoning_level"]
    values = {
        "model_provider": SESSION_PROVIDER_ID,
        "model": active_proxy_id,
        "model_reasoning_effort": current_effort,
        "model_catalog_json": str(MODEL_CATALOG_PATH),
    }
    updated = update_top_level(configured_proxy_text(current), values)
    if updated != current:
        write_config(updated, backup=True)
    save_state(MODEL_STATE_PATH, state)
    start_proxy()
    return warnings, active_proxy_id


def proxy_process_pid() -> int | None:
    try:
        return int(PROXY_PID_PATH.read_text(encoding="ascii").strip())
    except (FileNotFoundError, ValueError, OSError):
        return None


def proxy_is_running() -> bool:
    pid = proxy_process_pid()
    if pid is None:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def start_proxy() -> bool:
    if proxy_is_running():
        return False
    script = PROXY_SCRIPT_PATH
    if not script.exists():
        script = Path(__file__).with_name("codex-provider-proxy")
    if not script.exists():
        raise SystemExit(f"Не найден скрипт прокси: {script}")

    PROXY_LOG_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with PROXY_LOG_PATH.open("ab") as log:
        process = subprocess.Popen(
            [sys.executable, str(script), "--port", "8765"],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    PROXY_PID_PATH.write_text(f"{process.pid}\n", encoding="ascii")
    for _ in range(30):
        try:
            with urllib.request.urlopen("http://127.0.0.1:8765/status", timeout=0.2) as response:
                if response.status == 200:
                    return True
        except (urllib.error.URLError, TimeoutError, OSError):
            time.sleep(0.1)
    raise SystemExit("Прокси не ответил после запуска. Подробности: provider-proxy.log")


def stop_proxy() -> bool:
    pid = proxy_process_pid()
    if not proxy_is_running():
        PROXY_PID_PATH.unlink(missing_ok=True)
        return False
    assert pid is not None
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if not proxy_is_running():
            break
        time.sleep(0.1)
    if proxy_is_running():
        os.kill(pid, signal.SIGKILL)
    PROXY_PID_PATH.unlink(missing_ok=True)
    return True


def command_proxy_configure(_: argparse.Namespace) -> None:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError as error:
        raise SystemExit(f"Не удалось прочитать JSON выбора: {error}")
    if not isinstance(payload, dict) or not isinstance(payload.get("models"), list):
        raise SystemExit("Ожидался JSON с массивом models.")

    state = load_state(MODEL_STATE_PATH)
    selections = []
    for item in payload["models"]:
        if not isinstance(item, dict):
            continue
        provider_id = str(item.get("provider_id", ""))
        model_id = str(item.get("model_id", ""))
        if provider_id and model_id:
            selections.append({"provider_id": provider_id, "model_id": model_id})

    compaction = ...
    if "compaction_model" in payload:
        value = payload["compaction_model"]
        compaction = (
            {
                "provider_id": str(value.get("provider_id", "")),
                "model_id": str(value.get("model_id", "")),
            }
            if isinstance(value, dict)
            else None
        )
    active = payload.get("active_model")
    active = (
        {
            "provider_id": str(active.get("provider_id", "")),
            "model_id": str(active.get("model_id", "")),
        }
        if isinstance(active, dict)
        else None
    )
    if isinstance(payload.get("auto_compact"), dict):
        compact = payload["auto_compact"]
        try:
            set_auto_compact_settings(
                state, str(compact.get("mode", "percent")), int(compact.get("value", 75))
            )
        except (TypeError, ValueError) as error:
            raise SystemExit(str(error))
    warnings, proxy_id = apply_proxy_configuration(
        state, selections, active=active, compaction=compaction
    )
    print(
        json.dumps(
            {
                "ok": True,
                "active_model": proxy_id,
                "selected": proxy_entries(state),
                "warnings": warnings,
            },
            ensure_ascii=False,
        )
    )


def command_proxy_select(args: argparse.Namespace) -> None:
    models = available_models(args.provider, force=args.refresh)
    model = find_model(models, args.model)
    if model is None:
        raise SystemExit(f"Модель {args.model} не найдена у провайдера {args.provider}.")
    state = load_state(MODEL_STATE_PATH)
    set_selected_model(state, args.provider, model["id"], True)
    current_selections = proxy_selections(state)
    warnings, proxy_id = apply_proxy_configuration(
        state,
        current_selections,
        active={"provider_id": args.provider, "model_id": model["id"]},
    )
