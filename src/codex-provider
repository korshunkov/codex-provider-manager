    for model in visible:
        marker = "★" if model["id"] in favorites else " "
        print(f"{marker} {model['id']} — {model['display_name']}")


def _provider_error_message(payload: bytes) -> str:
    try:
        decoded = json.loads(payload.decode("utf-8", errors="replace"))
    except json.JSONDecodeError:
        decoded = None
    if isinstance(decoded, dict):
        error = decoded.get("error")
        if isinstance(error, dict) and error.get("message"):
            return str(error["message"])
        if decoded.get("message"):
            return str(decoded["message"])
    text = payload.decode("utf-8", errors="replace").strip()
    return text[:500] or "Провайдер не вернул подробности ошибки."


def _test_streaming_response(
    base_url: str,
    api_key: str,
    model_id: str,
    reasoning_effort: str,
) -> str | None:
    """Return an error message, or None after a complete streaming response."""
    request_body = {
        "model": model_id,
        "input": "Ответь ровно одним словом: ok",
        "max_output_tokens": 16,
        "stream": True,
        "reasoning": {"effort": reasoning_effort},
    }
    request = urllib.request.Request(
        f"{base_url.rstrip('/')}/responses",
        data=json.dumps(request_body).encode("utf-8"),
        headers={
            "Accept": "text/event-stream",
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}",
            "User-Agent": "CodexProviderManager/1.0",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=45) as response:
            payload = response.read()
        if b"response.completed" not in payload:
            return "Потоковый ответ оборвался до завершения."
        return None
    except urllib.error.HTTPError as error:
        return f"Провайдер вернул HTTP {error.code}: {_provider_error_message(error.read())}"
    except (urllib.error.URLError, TimeoutError, OSError) as error:
        return f"Не удалось связаться с провайдером: {error}"


def command_test_model(args: argparse.Namespace) -> None:
    provider_id = args.provider
    models = available_models(provider_id, force=args.refresh)
    selected = find_model(models, args.model)
    if selected is None:
        raise SystemExit(f"Модель {args.model} не найдена у провайдера {provider_id}.")

    credentials = load_credentials()
    credential_id = "openrouter" if provider_id == "openrouter-all" else provider_id
    api_key = credentials.get(credential_id)
    result = {
        "provider": provider_id,
        "model": selected["id"],
        "ok": False,
        "message": "",
        "supports_search_tool": selected.get("supports_search_tool"),
        "supports_function_tools": selected.get("supports_function_tools", True),
        "reasoning_levels": selected["reasoning_levels"],
        "attempts": COMPATIBILITY_TEST_ATTEMPTS,
    }
    if not api_key:
        result["message"] = "Для этого провайдера не найден ключ."
        print(json.dumps(result, ensure_ascii=False))
        return

    reasoning_effort = selected["default_reasoning_level"]
    errors: list[str] = []
    for attempt in range(1, COMPATIBILITY_TEST_ATTEMPTS + 1):
        error = _test_streaming_response(
            str(PROVIDERS[provider_id]["base_url"]),
            api_key,
            selected["id"],
            reasoning_effort,
        )
        if error:
            errors.append(f"попытка {attempt}: {error}")

    if errors:
        result["message"] = f"Потоковый запрос не прошёл: {'; '.join(errors)}"
    else:
        result["ok"] = True
        result["message"] = "Модель ответила на короткий потоковый запрос."
    print(json.dumps(result, ensure_ascii=False))


