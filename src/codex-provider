def prepare_model_catalog(
    provider_id: str,
    selected_model: dict,
    models: list[dict],
    state: dict,
) -> list[dict]:
    remember_model(state, provider_id, selected_model["id"])
    shelf = build_shelf(provider_id, PROVIDERS[provider_id], models, state, selected_model["id"])
    if not CODEX_BINARY.exists():
        raise SystemExit(f"Не найден исполняемый файл Codex: {CODEX_BINARY}")
    try:
        write_codex_catalog(MODEL_CATALOG_PATH, shelf, CODEX_BINARY, provider_id)
    except (RuntimeError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        raise SystemExit(f"Не удалось создать каталог моделей Codex: {error}") from error
    save_state(MODEL_STATE_PATH, state)
    return shelf


