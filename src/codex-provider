def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="codex-provider",
        description="Переключение между настроенными провайдерами Codex.",
    )
    subcommands = parser.add_subparsers(dest="command", required=True)

    install = subcommands.add_parser("install", help="добавить или обновить настройки провайдеров")
    install.set_defaults(handler=command_install)

    listing = subcommands.add_parser("list", help="показать провайдеров")
    listing.set_defaults(handler=command_list)

    current = subcommands.add_parser("current", help="показать текущего провайдера")
    current.set_defaults(handler=command_current)

    use = subcommands.add_parser("use", help="переключить провайдера")
    use.add_argument("provider", choices=PROVIDERS.keys())
    use.add_argument("--keep-model", action="store_true", help="не менять текущую модель")
    use.add_argument("--model", help="сразу выбрать модель у нового провайдера")
    use.add_argument("--refresh", action="store_true", help="обновить список моделей с сервера")
    use.set_defaults(handler=command_use)

    models = subcommands.add_parser("models", help="найти или показать модели провайдера")
    models.add_argument("provider", nargs="?", choices=PROVIDERS.keys())
    models.add_argument("--search", default="", help="поиск по названию модели")
    models.add_argument("--limit", type=int, default=50)
    models.add_argument("--format", choices=("text", "tsv", "json"), default="text")
    models.add_argument("--refresh", action="store_true", help="обновить список с сервера")
    models.set_defaults(handler=command_models)

    test_model = subcommands.add_parser("test-model", help="проверить модель потоковым запросом")
    test_model.add_argument("provider", choices=PROVIDERS.keys())
    test_model.add_argument("--model", required=True)
    test_model.add_argument("--refresh", action="store_true", help="обновить метаданные модели")
    test_model.set_defaults(handler=command_test_model)

    select_model = subcommands.add_parser("select-model", help="выбрать модель текущего провайдера")
    select_model.add_argument("model")
    select_model.add_argument("--refresh", action="store_true")
    select_model.set_defaults(handler=command_select_model)

    favorite = subcommands.add_parser("favorite", help="добавить модель в избранное")
    favorite.add_argument("model")
    favorite.add_argument("--provider", choices=PROVIDERS.keys())
    favorite.add_argument("--remove", action="store_true", help="убрать из избранного")
    favorite.set_defaults(handler=command_favorite)

    proxy = subcommands.add_parser("proxy", help="управление локальным прокси моделей")
    proxy_subcommands = proxy.add_subparsers(dest="proxy_action", required=True)
    proxy_status = proxy_subcommands.add_parser("status", help="показать состояние прокси")
    proxy_status.set_defaults(handler=command_proxy_status)
    proxy_configure = proxy_subcommands.add_parser("configure", help="применить JSON со списком моделей")
    proxy_configure.add_argument("--stdin", action="store_true")
    proxy_configure.set_defaults(handler=command_proxy_configure)
    proxy_select = proxy_subcommands.add_parser("select", help="сделать модель активной")
    proxy_select.add_argument("provider", choices=PROVIDERS.keys())
    proxy_select.add_argument("--model", required=True)
    proxy_select.add_argument("--refresh", action="store_true")
    proxy_select.set_defaults(handler=command_proxy_select)
    proxy_start = proxy_subcommands.add_parser("start", help="запустить прокси")
    proxy_start.set_defaults(handler=command_proxy_start)
    proxy_stop = proxy_subcommands.add_parser("stop", help="остановить прокси")
    proxy_stop.set_defaults(handler=command_proxy_stop)

    provider_settings = subcommands.add_parser("provider-settings", help="показать настройки провайдеров в JSON")
    provider_settings.set_defaults(handler=command_provider_settings)
    provider_add = subcommands.add_parser("provider-add", help="добавить OpenAI-совместимого провайдера")
    provider_add.add_argument("--label", required=True)
    provider_add.add_argument("--prefix", required=True)
    provider_add.add_argument("--base-url", required=True)
    provider_add.add_argument("--models-url", default="")
    provider_add.add_argument("--api-key-stdin", action="store_true")
    provider_add.set_defaults(handler=command_provider_add)
    provider_remove = subcommands.add_parser("provider-remove", help="удалить добавленного провайдера")
    provider_remove.add_argument("provider")
    provider_remove.set_defaults(handler=command_provider_remove)
    provider_key = subcommands.add_parser("provider-key", help="безопасно обновить ключ провайдера")
    provider_key.add_argument("provider")
    provider_key.add_argument("--stdin", action="store_true")
    provider_key.set_defaults(handler=command_provider_key)
    provider_key_show = subcommands.add_parser("provider-key-show", help="показать текущий ключ провайдера в JSON")
    provider_key_show.add_argument("provider")
    provider_key_show.set_defaults(handler=command_provider_key_show)
    auto_compact = subcommands.add_parser("set-auto-compact", help="настроить уровень автокомпакта")
    auto_compact.add_argument("--mode", choices=("percent", "tokens"), required=True)
    auto_compact.add_argument("--value", type=int, required=True)
    auto_compact.set_defaults(handler=command_auto_compact)

    set_key = subcommands.add_parser("set-key", help="безопасно заменить ключ провайдера")
    set_key.add_argument("provider", choices=PROVIDERS.keys())
    set_key.set_defaults(handler=command_set_key)
    return parser


def main() -> None:
    refresh_provider_registry(load_state(MODEL_STATE_PATH))
    parser = build_parser()
    arguments = parser.parse_args()
    arguments.handler(arguments)


if __name__ == "__main__":
    main()
