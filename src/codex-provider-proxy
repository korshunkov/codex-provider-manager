def error_payload(message: str) -> dict[str, Any]:
    """OpenAI-style error body; Codex reads only error.message."""
    return {"error": {"message": message}}


def _diagnostic_summary(value: Any) -> dict[str, Any]:
    """Return a small allow-listed summary; never serialize request content."""
    result: dict[str, Any] = {}
    if not isinstance(value, dict):
        return result
    for key in ("model", "endpoint", "status", "call_id", "id", "namespace",
                "tool_name", "item_type", "duration_ms", "request_bytes",
                "response_bytes", "http_status"):
        item = value.get(key)
        if isinstance(item, (str, int, float, bool)) or item is None:
            result[key] = item
    return result


def diagnostic_request(data: dict[str, Any], endpoint: str, request_bytes: int) -> dict[str, Any]:
    event: dict[str, Any] = {
        "event": "request",
        "endpoint": endpoint,
        "request_bytes": request_bytes,
    }
    if isinstance(data.get("model"), str):
        event["model"] = data["model"]
    items = data.get("input", data.get("messages", []))
    if isinstance(items, list):
        event["item_types"] = [
            item.get("type", item.get("role", "unknown"))
            for item in items if isinstance(item, dict)
        ][:100]
        calls = []
        for item in items:
            if not isinstance(item, dict):
                continue
            if item.get("type") in ("function_call", "function_call_output") or item.get("role") == "tool":
                call = {"call_id": item.get("call_id") or item.get("tool_call_id")}
                if isinstance(call["call_id"], str):
                    calls.append(call)
        if calls:
            event["tool_calls"] = calls[:100]
    tools = data.get("tools")
    if isinstance(tools, list):
        names = []
        namespaces = []
        for tool in tools:
            if not isinstance(tool, dict):
                continue
            function = tool.get("function") if isinstance(tool.get("function"), dict) else tool
            if isinstance(function.get("name"), str):
                names.append(function["name"])
            if isinstance(function.get("namespace"), str):
                namespaces.append(function["namespace"])
        if names:
            event["tool_names"] = names[:100]
        if namespaces:
            event["namespaces"] = namespaces[:100]
    return event


def diagnostic_response(
    data: Any,
    endpoint: str,
    http_status: int | None,
    response_bytes: int,
    duration_ms: float | None = None,
) -> dict[str, Any]:
    """Summarize response shape while excluding all response content."""
    event: dict[str, Any] = {
        "event": "response",
        "endpoint": endpoint,
        "http_status": http_status,
        "response_bytes": response_bytes,
    }
    if duration_ms is not None:
        event["duration_ms"] = duration_ms
    if not isinstance(data, dict):
        return event
    if isinstance(data.get("model"), str):
        event["model"] = data["model"]
    items = data.get("output")
    if not isinstance(items, list):
        choices = data.get("choices")
        if isinstance(choices, list):
            items = [
                choice.get("message", {})
                for choice in choices
                if isinstance(choice, dict)
            ]
    if isinstance(items, list):
        event["item_types"] = [
            item.get("type", item.get("role", "unknown"))
            for item in items if isinstance(item, dict)
        ][:100]
        calls = []
        names = []
        namespaces = []
        for item in items:
            if not isinstance(item, dict):
                continue
            function = item.get("function") if isinstance(item.get("function"), dict) else item
            call_id = item.get("call_id") or item.get("tool_call_id") or item.get("id")
            if item.get("type") in ("function_call", "function_call_output") or item.get("role") == "tool" or item.get("tool_calls"):
                if isinstance(call_id, str):
                    calls.append({"call_id": call_id})
            if isinstance(function.get("name"), str):
                names.append(function["name"])
            if isinstance(function.get("namespace"), str):
                namespaces.append(function["namespace"])
            for call in item.get("tool_calls", []) if isinstance(item.get("tool_calls"), list) else []:
                if not isinstance(call, dict):
                    continue
                call_function = call.get("function") if isinstance(call.get("function"), dict) else call
                if isinstance(call.get("id"), str):
                    calls.append({"call_id": call["id"]})
                if isinstance(call_function.get("name"), str):
                    names.append(call_function["name"])
                if isinstance(call_function.get("namespace"), str):
                    namespaces.append(call_function["namespace"])
        if calls:
            event["tool_calls"] = calls[:100]
        if names:
            event["tool_names"] = names[:100]
        if namespaces:
            event["namespaces"] = namespaces[:100]
    return event


def write_diagnostic(event: dict[str, Any]) -> None:
    """Best-effort diagnostic journal. Logging failures never affect proxy work."""
    try:
        now = time.time()
        record = {"ts": now, **_diagnostic_summary(event)}
        for key in ("event", "item_types", "tool_calls", "tool_names", "namespaces"):
            if key in event:
                record[key] = event[key]
        line = (json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
        with _DIAGNOSTICS_LOCK:
            DIAGNOSTICS_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            cutoff = now - DIAGNOSTICS_MAX_AGE_SECONDS
            kept: list[bytes] = []
            if DIAGNOSTICS_PATH.exists():
                for raw in DIAGNOSTICS_PATH.read_bytes().splitlines(keepends=True):
                    try:
                        old = json.loads(raw)
                        if float(old.get("ts", now)) >= cutoff:
                            kept.append(raw)
                    except (ValueError, TypeError):
                        continue
            kept.append(line)
            while sum(map(len, kept)) > DIAGNOSTICS_MAX_BYTES and kept:
                kept.pop(0)
            DIAGNOSTICS_PATH.write_bytes(b"".join(kept))
    except Exception:
        return


def provider_map(state: dict[str, Any]) -> dict[str, dict[str, Any]]:
    providers = dict(DEFAULT_PROVIDER_MAP)
    records = state.get("providers", [])
    if isinstance(records, list):
        for item in records:
            if not isinstance(item, dict):
                continue
            provider_id = str(item.get("id", "")).strip()
            base_url = str(item.get("base_url", "")).strip()
            alias = str(item.get("alias", "")).strip()
            if provider_id and base_url.startswith(("http://", "https://")) and alias:
                api_mode = str(item.get("api_mode", "responses")).strip()
                if api_mode not in ("responses", "chat"):
                    api_mode = "responses"
                providers[provider_id] = {
                    "base_url": base_url.rstrip("/"),
                    "credential_id": str(item.get("credential_id", provider_id)),
                    "alias": alias,
                    "api_mode": api_mode,
                }
    return providers


def proxy_model_id(
    provider_id: str,
    model_id: str,
    providers: dict[str, dict[str, str]] | None = None,
) -> str:
    if providers is None:
        if provider_id == "anymodel" and model_id.startswith("am/"):
            return model_id
        alias = ALIASES.get(provider_id)
        return f"{alias}/{model_id}" if alias else model_id
    if provider_id == "anymodel" and model_id.startswith("am/"):
        return model_id
    alias = providers.get(provider_id, {}).get("alias", "")
    return f"{alias}/{model_id}" if alias else model_id


def load_state() -> dict[str, Any]:
    try:
        state = json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}
    return state if isinstance(state, dict) else {}


def selected_models(state: dict[str, Any]) -> list[dict[str, str]]:
    result: list[dict[str, str]] = []
    seen: set[str] = set()
    for item in state.get("selected_models", []):
        if not isinstance(item, dict):
            continue
        provider_id = str(item.get("provider_id", ""))
        model_id = str(item.get("model_id", ""))
        key = f"{provider_id}|{model_id}"
        if provider_id in provider_map(state) and model_id and key not in seen:
            seen.add(key)
            result.append({"provider_id": provider_id, "model_id": model_id})
    return result


def compaction_model(state: dict[str, Any]) -> dict[str, str] | None:
    item = state.get("compaction_model")
    if not isinstance(item, dict):
        return None
    provider_id = str(item.get("provider_id", ""))
    model_id = str(item.get("model_id", ""))
    if provider_id in provider_map(state) and model_id:
        return {"provider_id": provider_id, "model_id": model_id}
    return None


def model_route(state: dict[str, Any], external_id: str) -> dict[str, str] | None:
    candidates = selected_models(state)
    compaction = compaction_model(state)
    if compaction:
        candidates.append(compaction)
    for item in candidates:
        if proxy_model_id(item["provider_id"], item["model_id"], provider_map(state)) == external_id:
            return item
    return None


def metadata_value(headers: dict[str, str], data: dict[str, Any], name: str) -> Any:
    """Read request metadata from headers or the Responses request body."""
    if name in data:
        return data[name]
    value = headers.get(name)
    if value is None:
        return None
    try:
        return json.loads(value)
    except json.JSONDecodeError:
        return value


def is_compaction_request(headers: dict[str, str], data: dict[str, Any]) -> bool:
    """Detect remote compaction v2, which uses the normal /responses path."""
    for name in ("request_kind", "x-request-kind", "x-codex-turn-metadata", "x-codex-turn-state"):
        value = metadata_value(headers, data, name)
        if isinstance(value, dict):
            value = value.get("request_kind")
        if value == "compaction":
            return True
    return False


def provider_key(provider_id: str, state: dict[str, Any]) -> str | None:
    try:
        credentials = json.loads(CREDENTIALS_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    credential_id = provider_map(state).get(provider_id, {}).get("credential_id", provider_id)
    value = credentials.get(credential_id) if isinstance(credentials, dict) else None
    return value.strip() if isinstance(value, str) and value.strip() else None


def content_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    chunks: list[str] = []
    for part in content:
        if isinstance(part, dict) and isinstance(part.get("text"), str):
            chunks.append(part["text"])
    return "\n".join(chunk for chunk in chunks if chunk)


def chat_messages_from_responses(data: dict[str, Any]) -> list[dict[str, Any]]:
    """Convert a Responses input to the Chat Completions message list."""
    messages: list[dict[str, Any]] = []
    instructions = data.get("instructions")
    if isinstance(instructions, str) and instructions:
        messages.append({"role": "system", "content": instructions})

    input_value = data.get("input", "")
    if isinstance(input_value, str):
        if input_value:
            messages.append({"role": "user", "content": input_value})
        return messages
    if not isinstance(input_value, list):
        return messages

    for item in input_value:
        if not isinstance(item, dict):
            continue
        item_type = item.get("type", "message")
        if item_type == "function_call":
            messages.append({
                "role": "assistant",
                "content": None,
                "tool_calls": [{
                    "id": str(item.get("call_id") or item.get("id") or ""),
                    "type": "function",
                    "function": {
                        "name": str(item.get("name", "")),
                        "arguments": str(item.get("arguments", "{}")),
                    },
                }],
            })
        elif item_type == "function_call_output":
            output = item.get("output")
            messages.append({
                "role": "tool",
                "tool_call_id": str(item.get("call_id", "")),
                "content": output if isinstance(output, str) else json.dumps(output, ensure_ascii=False),
            })
        else:
            role = str(item.get("role", "user"))
            messages.append({"role": role, "content": content_text(item.get("content"))})
    return messages


def tools_chat_from_responses(data: dict[str, Any]) -> list[dict[str, Any]] | None:
    tools = data.get("tools")
    if not isinstance(tools, list):
        return None
    result: list[dict[str, Any]] = []
    for tool in tools:
        if not isinstance(tool, dict) or tool.get("type") != "function":
            continue
        result.append({
            "type": "function",
            "function": {
                "name": tool.get("name"),
                "description": tool.get("description"),
                "parameters": tool.get("parameters") or {"type": "object", "properties": {}},
            },
        })
    return result or None


def chat_payload_from_responses(data: dict[str, Any], model_id: str) -> dict[str, Any]:
    payload: dict[str, Any] = {
        "model": model_id,
        "messages": chat_messages_from_responses(data),
    }
    tools = tools_chat_from_responses(data)
    if tools:
        payload["tools"] = tools
    for name in ("tool_choice", "temperature", "top_p", "user", "parallel_tool_calls"):
        if name in data and data[name] is not None:
            payload[name] = data[name]
    if "max_output_tokens" in data:
        payload["max_tokens"] = data["max_output_tokens"]
    if isinstance(data.get("stop"), (str, list)):
        payload["stop"] = data["stop"]
    if isinstance(data.get("response_format"), dict):
        payload["response_format"] = data["response_format"]
    return payload


def responses_input_from_chat(data: dict[str, Any]) -> list[dict[str, Any]]:
    """Convert Chat messages into the list form accepted by Responses."""
    result: list[dict[str, Any]] = []
    messages = data.get("messages", [])
    if not isinstance(messages, list):
        return result
    for message in messages:
        if not isinstance(message, dict):
            continue
        role = str(message.get("role", "user"))
        content = message.get("content")
        if role == "tool":
            result.append({
                "type": "function_call_output",
                "call_id": str(message.get("tool_call_id", "")),
                "output": content if isinstance(content, str) else json.dumps(content, ensure_ascii=False),
            })
            continue
        if role == "assistant" and isinstance(message.get("tool_calls"), list):
            for call in message["tool_calls"]:
                if not isinstance(call, dict):
                    continue
                function = call.get("function") if isinstance(call.get("function"), dict) else {}
                result.append({
                    "type": "function_call",
                    "call_id": str(call.get("id", "")),
                    "name": str(function.get("name", "")),
                    "arguments": str(function.get("arguments", "{}")),
                })
            text = content_text(content)
            if text:
                result.append({
                    "role": "assistant",
                    "content": [{"type": "output_text", "text": text}],
                })
            continue
        text = content_text(content)
        part_type = "output_text" if role == "assistant" else "input_text"
        result.append({
            "role": role,
            "content": [{"type": part_type, "text": text}] if text else [],
        })
    return result


def tools_responses_from_chat(data: dict[str, Any]) -> list[dict[str, Any]] | None:
    tools = data.get("tools")
    if not isinstance(tools, list):
        return None
    result: list[dict[str, Any]] = []
    for tool in tools:
        if not isinstance(tool, dict) or tool.get("type") != "function":
            continue
        function = tool.get("function") if isinstance(tool.get("function"), dict) else {}
        result.append({
            "type": "function",
            "name": function.get("name"),
            "description": function.get("description"),
            "parameters": function.get("parameters") or {"type": "object", "properties": {}},
        })
    return result or None


def responses_payload_from_chat(data: dict[str, Any], model_id: str) -> dict[str, Any]:
    instructions = []
    for message in data.get("messages", []):
        if isinstance(message, dict) and message.get("role") in ("system", "developer"):
            text = content_text(message.get("content"))
            if text:
                instructions.append(text)
    payload: dict[str, Any] = {
        "model": model_id,
        "input": responses_input_from_chat(data),
        "store": False,
    }
    if instructions:
        payload["instructions"] = "\n\n".join(instructions)
    tools = tools_responses_from_chat(data)
    if tools:
        payload["tools"] = tools
    for name in ("tool_choice", "temperature", "top_p", "user", "parallel_tool_calls"):
        if name in data and data[name] is not None:
            payload[name] = data[name]
    if "max_tokens" in data:
        payload["max_output_tokens"] = data["max_tokens"]
    if isinstance(data.get("response_format"), dict):
        payload["response_format"] = data["response_format"]
    return payload


def upstream_payload(
    data: dict[str, Any], model_id: str, upstream_mode: str, inbound_mode: str
) -> dict[str, Any]:
    if upstream_mode == inbound_mode:
        payload = dict(data)
        payload["model"] = model_id
        return payload
    # Format conversion buffers the upstream answer. Full streaming can only
    # be guaranteed when both sides speak the same protocol.
    payload = (
        responses_payload_from_chat(data, model_id)
        if upstream_mode == "responses"
        else chat_payload_from_responses(data, model_id)
    )
    payload["stream"] = False
    return payload


def _response_usage(source: dict[str, Any], responses_style: bool) -> dict[str, int]:
    usage = source.get("usage") if isinstance(source.get("usage"), dict) else {}
    if responses_style:
        return {
            "input_tokens": int(usage.get("input_tokens") or usage.get("prompt_tokens") or 0),
            "output_tokens": int(usage.get("output_tokens") or usage.get("completion_tokens") or 0),
            "total_tokens": int(usage.get("total_tokens") or 0),
        }
    return {
        "prompt_tokens": int(usage.get("prompt_tokens") or usage.get("input_tokens") or 0),
        "completion_tokens": int(usage.get("completion_tokens") or usage.get("output_tokens") or 0),
        "total_tokens": int(usage.get("total_tokens") or 0),
    }


def chat_completion_from_responses(
    payload: dict[str, Any], external_model: str
) -> dict[str, Any]:
    text_chunks: list[str] = []
    tool_calls: list[dict[str, Any]] = []
    for item in payload.get("output", []) if isinstance(payload.get("output"), list) else []:
        if not isinstance(item, dict):
            continue
        if item.get("type") == "function_call":
            tool_calls.append({
                "id": str(item.get("call_id") or item.get("id") or ""),
                "type": "function",
                "function": {
                    "name": str(item.get("name", "")),
                    "arguments": str(item.get("arguments", "{}")),
                },
            })
        elif item.get("type") == "message":
            text = content_text(item.get("content"))
            if text:
                text_chunks.append(text)
    if isinstance(payload.get("output_text"), str) and payload["output_text"]:
        text_chunks.append(payload["output_text"])
    message: dict[str, Any] = {"role": "assistant", "content": "\n".join(text_chunks)}
    finish_reason = "stop"
    if tool_calls:
        message["tool_calls"] = tool_calls
        finish_reason = "tool_calls"
    return {
        "id": f"chat_proxy_{int(time.time() * 1000)}",
        "object": "chat.completion",
        "created": int(time.time()),
        "model": external_model,
        "choices": [{
            "index": 0,
            "message": message,
            "finish_reason": finish_reason,
        }],
        "usage": _response_usage(payload, responses_style=False),
    }


def responses_from_chat_completion(
    payload: dict[str, Any], external_model: str
) -> dict[str, Any]:
    choice = payload.get("choices", [{}])[0] if isinstance(payload.get("choices"), list) else {}
    choice = choice if isinstance(choice, dict) else {}
    message = choice.get("message") if isinstance(choice.get("message"), dict) else {}
    output: list[dict[str, Any]] = []
    text = content_text(message.get("content"))
    if text:
        output.append({
            "id": f"msg_{int(time.time() * 1000)}",
            "type": "message",
            "status": "completed",
            "role": "assistant",
            "content": [{"type": "output_text", "text": text}],
        })
    for index, call in enumerate(message.get("tool_calls", []) or []):
        if not isinstance(call, dict):
            continue
        function = call.get("function") if isinstance(call.get("function"), dict) else {}
        output_item = {
            "id": f"call_{index}_{int(time.time() * 1000)}",
            "type": "function_call",
            "status": "completed",
            "call_id": str(call.get("id", "")),
            "name": str(function.get("name", "")),
            "arguments": str(function.get("arguments", "{}")),
        }
        namespace = call.get("namespace")
        if isinstance(namespace, str) and namespace:
            output_item["namespace"] = namespace
        output.append(output_item)
    return {
        "id": f"resp_proxy_{int(time.time() * 1000)}",
        "object": "response",
        "created_at": int(time.time()),
        "model": external_model,
        "status": "completed",
        "output": output,
        "usage": _response_usage(payload, responses_style=True),
    }


def sse_body(events: list[dict[str, Any]]) -> bytes:
    return "".join(
        f"data: {json.dumps(event, ensure_ascii=False)}\n\n" for event in events
    ).encode("utf-8")


def request_headers(provider_id: str, incoming: dict[str, str], state: dict[str, Any]) -> dict[str, str]:
    api_key = provider_key(provider_id, state)
    if not api_key:
        raise RuntimeError(f"Ключ провайдера {provider_id} не настроен.")
    headers = {
        "Accept": incoming.get("accept", "application/json"),
        "Authorization": f"Bearer {api_key}",
        "Content-Type": incoming.get("content_type", "application/json"),
        "User-Agent": "CodexProviderProxy/1.0",
        "Accept-Encoding": "identity",
    }
    # Metadata headers are useful to providers which implement Codex semantics.
    for name in ("session_id", "x-openai-subagent", "x-codex-turn-state"):
        if incoming.get(name.lower()):
            headers[name] = incoming[name.lower()]
    return headers


def response_text(payload: dict[str, Any]) -> str:
    """Extract compaction material from a normal Responses API result."""
    chunks: list[str] = []
    output = payload.get("output", [])
    if isinstance(output, list):
        for item in output:
            if not isinstance(item, dict):
                continue
            if item.get("type") == "compaction" and item.get("encrypted_content"):
                chunks.append(str(item["encrypted_content"]))
            content = item.get("content", [])
            if isinstance(content, list):
                for part in content:
                    if isinstance(part, dict) and part.get("text"):
                        chunks.append(str(part["text"]))
    # Some OpenAI-compatible gateways answer a non-streaming Responses call
    # with a Chat Completions body. Reuse its text for compaction.
    choices = payload.get("choices", [])
    if isinstance(choices, list) and choices:
        message = choices[0].get("message", {}) if isinstance(choices[0], dict) else {}
        if message.get("content"):
            chunks.append(str(message["content"]))
        for call in message.get("tool_calls", []) or []:
            if isinstance(call, dict) and call.get("function", {}).get("arguments"):
                chunks.append(str(call["function"]["arguments"]))
    if not chunks and isinstance(payload.get("output_text"), str):
        chunks.append(payload["output_text"])
    return "\n".join(chunk for chunk in chunks if chunk)


def observe_sse_terminal(chunk: bytes, pending_event: bytearray) -> bool:
    """Detect a Responses API terminal event without buffering the whole stream."""
    pending_event.extend(chunk)
    while True:
        lf_end = pending_event.find(b"\n\n")
        crlf_end = pending_event.find(b"\r\n\r\n")
        if crlf_end != -1 and (lf_end == -1 or crlf_end < lf_end):
            end, separator_length = crlf_end, 4
        elif lf_end != -1:
            end, separator_length = lf_end, 2
        else:
            return False

        event = bytes(pending_event[:end])
        del pending_event[: end + separator_length]
        event_type = None
        for line in event.splitlines():
            name, separator, value = line.partition(b":")
            if not separator:
                continue
            if name.strip().lower() == b"event":
                event_type = value.strip().decode("ascii", "ignore").lower()
                break
            if name.strip().lower() == b"data" and event_type is None:
                if value.strip() == b"[DONE]":
                    event_type = "chat.done"
                    break
                try:
                    payload = json.loads(value.strip().decode("utf-8"))
                except (UnicodeDecodeError, json.JSONDecodeError):
                    continue
                if isinstance(payload, dict) and isinstance(payload.get("type"), str):
                    event_type = payload["type"].lower()
        if event_type in SSE_TERMINAL_EVENTS:
            return True


class ProxyHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "CodexProviderProxy/1.0"
    timeout = 120

    def send_response(self, code: int, message: str | None = None) -> None:
        self._diagnostic_status = code
        super().send_response(code, message)

    def log_message(self, format: str, *args: Any) -> None:
        # Access logs do not contain request or response content.
        logging.info("%s %s", self.command, self.path.split("?", 1)[0])

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path in ("/status", "/health"):
            self.send_json({"ok": True, "providers": sorted(provider_map(load_state()))})
        elif path in ("/models", "/v1/models"):
            state = load_state()
            providers = provider_map(state)
            created = int(time.time())
            seen: set[str] = set()
            records: list[dict[str, Any]] = []
            candidates = selected_models(state)
            compaction = compaction_model(state)
            if compaction:
                candidates.append(compaction)
            for item in candidates:
                external_id = proxy_model_id(
                    item["provider_id"], item["model_id"], providers
                )
                if external_id in seen:
                    continue
                seen.add(external_id)
                records.append({
                    "id": external_id,
                    "object": "model",
                    "created": created,
                    "owned_by": item["provider_id"],
                })
            self.send_json({"object": "list", "data": records})
        else:
            self.send_json(error_payload("Not found"), status=404)

    def do_POST(self) -> None:
        started_at = time.monotonic()
        raw = b""
        data: dict[str, Any] = {}
        path = self.path.split("?", 1)[0]
        responses_paths = ("/responses", "/v1/responses", "/responses/compact", "/v1/responses/compact")
        chat_paths = ("/chat/completions", "/v1/chat/completions")
        # Record the arrival before validation so every POST has a journal row,
        # including unsupported paths and malformed JSON bodies.
        write_diagnostic({"event": "request_received", "endpoint": path})
        if path not in responses_paths + chat_paths:
            self.send_json(error_payload(f"Endpoint {path} не поддерживается."), status=404)
            return

        try:
            length = int(self.headers.get("Content-Length", "0"))
            raw = self.rfile.read(length) if length else b"{}"
            data = json.loads(raw.decode("utf-8"))
            if not isinstance(data, dict):
                raise ValueError("Тело запроса должно быть JSON-объектом.")
        except (ValueError, json.JSONDecodeError, UnicodeDecodeError) as error:
            write_diagnostic({"event": "request", "endpoint": path, "request_bytes": len(raw)})
            self.send_json(error_payload(f"Некорректный запрос: {error}"), status=400)
            return

        state = load_state()
        write_diagnostic(diagnostic_request(data, path, len(raw)))
        try:
            if path in responses_paths and path.endswith("/compact"):
                self.handle_compact(data, state)
            elif path in chat_paths:
                self.handle_chat_completions(data, state)
            else:
                self.handle_responses(data, state)
        except (BrokenPipeError, ConnectionResetError):
            logging.warning("Клиент отключился во время ответа.")
        except (RuntimeError, urllib.error.URLError, TimeoutError, OSError) as error:
            logging.error("Запрос не выполнен: %s", error)
            self.send_json(error_payload(str(error)), status=502)
        except Exception as error:
            logging.exception("Внутренняя ошибка прокси")
            self.send_json(error_payload(f"Внутренняя ошибка: {error}"), status=500)
        finally:
            write_diagnostic(diagnostic_response(
                getattr(self, "_diagnostic_response_payload", None),
                path,
                getattr(self, "_diagnostic_status", None),
                getattr(self, "_diagnostic_response_bytes", 0),
                round((time.monotonic() - started_at) * 1000, 2),
            ))

    def incoming_headers(self) -> dict[str, str]:
        return {name.lower(): value for name, value in self.headers.items()}

    def handle_responses(self, data: dict[str, Any], state: dict[str, Any]) -> None:
        external_id = str(data.get("model", ""))
        if is_compaction_request(self.incoming_headers(), data):
            self.handle_compact(data, state)
            return
        route = model_route(state, external_id)
        if route is None:
            self.send_json(
                error_payload(f"Модель {external_id or '(не задана)'} не включена в прокси."),
                status=404,
            )
            return
        providers = provider_map(state)
        provider = providers[route["provider_id"]]
        upstream_mode = str(provider.get("api_mode", "responses"))
        payload = upstream_payload(data, route["model_id"], upstream_mode, "responses")
        upstream_url = f"{provider['base_url'].rstrip('/')}/{'chat/completions' if upstream_mode == 'chat' else 'responses'}"
        if upstream_mode == "responses":
            self.forward(upstream_url, payload, route["provider_id"], state)
        else:
            self.forward_converted(
                upstream_url,
                payload,
                route["provider_id"],
                state,
                external_id,
                inbound_mode="responses",
                stream_requested=data.get("stream") is True,
            )

    def handle_chat_completions(self, data: dict[str, Any], state: dict[str, Any]) -> None:
        external_id = str(data.get("model", ""))
        route = model_route(state, external_id)
        if route is None:
            self.send_json(
                error_payload(f"Модель {external_id or '(не задана)'} не включена в прокси."),
                status=404,
            )
            return
        providers = provider_map(state)
        provider = providers[route["provider_id"]]
        upstream_mode = str(provider.get("api_mode", "responses"))
        payload = upstream_payload(data, route["model_id"], upstream_mode, "chat")
        upstream_url = f"{provider['base_url'].rstrip('/')}/{'chat/completions' if upstream_mode == 'chat' else 'responses'}"
        if upstream_mode == "chat":
            self.forward(upstream_url, payload, route["provider_id"], state)
        else:
            self.forward_converted(
                upstream_url,
                payload,
                route["provider_id"],
                state,
                external_id,
                inbound_mode="chat",
                stream_requested=data.get("stream") is True,
            )

    def handle_compact(self, data: dict[str, Any], state: dict[str, Any]) -> None:
        route = compaction_model(state)
        if route is None:
            self.send_json(error_payload("Модель для компакта не выбрана."), status=409)
            return

        payload = {
            "model": route["model_id"],
            "input": data.get("input", data.get("messages", "")),
            "instructions": data.get(
                "instructions", "Сожми историю разговора, сохранив важные факты и решения."
            ),
            "store": False,
            "stream": False,
            "max_output_tokens": 4096,
        }
        providers = provider_map(state)
        upstream_url = f"{providers[route['provider_id']]['base_url'].rstrip('/')}/responses"
        response = self.upstream_response(upstream_url, payload, route["provider_id"], state)
        try:
            body = response.read()
            status = response.status
        finally:
            response.close()
        if status != 200:
            self._diagnostic_response_bytes = len(body)
            self.forward_error(status, body)
            return
        try:
            result = json.loads(body.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            self.send_json(error_payload(f"Провайдер вернул не JSON: {error}"), status=502)
            return
        text = response_text(result if isinstance(result, dict) else {})
        if not text:
            self.send_json(error_payload("Провайдер не вернул текст для компакта."), status=502)
            return
        logging.info(
            "Компакт направлен: %s/%s",
            route["provider_id"],
            route["model_id"],
        )
        response_id = f"resp_compact_{int(time.time() * 1000)}"
        item = {
            "id": f"item_{response_id}",
            "type": "compaction",
            "encrypted_content": text,
        }
        response = {
            "id": response_id,
            "object": "response",
            "created_at": int(time.time()),
            "model": proxy_model_id(route["provider_id"], route["model_id"], provider_map(state)),
            "status": "completed",
            "output": [item],
        }
        if data.get("stream") is True:
            self.send_compaction_stream(response, item)
        else:
            self.send_json(response)

    def send_compaction_stream(
        self, response: dict[str, Any], item: dict[str, Any]
    ) -> None:
        """Return the SSE shape expected by remote compaction v2."""
        in_progress = dict(response)
        in_progress["status"] = "in_progress"
        in_progress["output"] = []
        events = [
            {"type": "response.created", "response": in_progress},
            {
                "type": "response.output_item.done",
                "output_index": 0,
                "item": item,
            },
            {"type": "response.completed", "response": response},
        ]
        body = "".join(
            f"event: {event['type']}" + chr(10)
            + "data: " + json.dumps(event, ensure_ascii=False) + chr(10) * 2
            for event in events
        )
        encoded = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(encoded)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(encoded)
        self.close_connection = True

    def forward_converted(
        self,
        url: str,
        payload: dict[str, Any],
        provider_id: str,
        state: dict[str, Any],
        external_model: str,
        *,
        inbound_mode: str,
        stream_requested: bool,
    ) -> None:
        """Convert a buffered mismatched-format answer to the client protocol."""
        response = self.upstream_response(url, payload, provider_id, state)
        try:
            body = response.read()
            status = response.status
        finally:
            response.close()
        if status != 200:
            self.forward_error(status, body)
            return
        try:
            source = json.loads(body.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            self.send_json(error_payload(f"Провайдер вернул не JSON: {error}"), status=502)
            return
        if not isinstance(source, dict):
            self.send_json(error_payload("Провайдер вернул неожиданный ответ."), status=502)
            return
        self._diagnostic_response_bytes = len(body)
        self._diagnostic_response_payload = source

        if inbound_mode == "responses":
            result = responses_from_chat_completion(source, external_model)
            if stream_requested:
                self.send_responses_stream(result)
            else:
                self.send_json(result)
        else:
            result = chat_completion_from_responses(source, external_model)
            if stream_requested:
                self.send_chat_stream(result)
            else:
                self.send_json(result)

    def send_chat_stream(self, completion: dict[str, Any]) -> None:
        choice = completion.get("choices", [{}])[0] if completion.get("choices") else {}
        choice = choice if isinstance(choice, dict) else {}
        message = choice.get("message") if isinstance(choice.get("message"), dict) else {}
        delta: dict[str, Any] = {}
        if message.get("content"):
            delta["content"] = message["content"]
        if message.get("tool_calls"):
            delta["tool_calls"] = message["tool_calls"]
        chunk = {
            "id": completion.get("id", f"chat_proxy_{int(time.time() * 1000)}"),
            "object": "chat.completion.chunk",
            "created": int(time.time()),
            "model": completion.get("model", ""),
            "choices": [{"index": 0, "delta": delta, "finish_reason": None}],
        }
        final = dict(chunk)
        final["choices"] = [{
            "index": 0,
            "delta": {},
            "finish_reason": choice.get("finish_reason", "stop"),
        }]
        encoded = sse_body([chunk, final]) + b"data: [DONE]\n\n"
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(encoded)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(encoded)
        self.close_connection = True

    def send_responses_stream(self, response: dict[str, Any]) -> None:
        in_progress = dict(response)
        in_progress["status"] = "in_progress"
        in_progress["output"] = []
        events: list[dict[str, Any]] = [
            {"type": "response.created", "response": in_progress}
        ]
        for output_index, item in enumerate(response.get("output", [])):
            events.append({
                "type": "response.output_item.done",
                "output_index": output_index,
                "item": item,
            })
        events.append({"type": "response.completed", "response": response})
        encoded = "".join(
            f"event: {event['type']}\ndata: {json.dumps(event, ensure_ascii=False)}\n\n"
            for event in events
        ).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(encoded)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(encoded)
        self.close_connection = True

    def upstream_response(
        self, url: str, payload: dict[str, Any], provider_id: str, state: dict[str, Any]
    ) -> urllib.request.urlopen:  # type: ignore[name-defined]
        encoded = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        request = urllib.request.Request(
            url,
            data=encoded,
            headers=request_headers(provider_id, self.incoming_headers(), state),
            method="POST",
        )
        try:
            return urllib.request.urlopen(request, timeout=READ_TIMEOUT)
        except urllib.error.HTTPError as error:
            # HTTPError carries the provider's useful error body and headers.
            return error

    def forward(
        self,
        url: str,
        payload: dict[str, Any],
        provider_id: str,
        state: dict[str, Any] | None = None,
    ) -> None:
        if state is None:
            response = self.upstream_response(url, payload, provider_id)
        else:
            response = self.upstream_response(url, payload, provider_id, state)
        is_stream = "text/event-stream" in (response.headers.get("Content-Type") or "")
        if payload.get("stream") is True and response.status == 200 and not is_stream:
            total_bytes = 0
            try:
                while True:
                    chunk = response.read(8192)
                    if not chunk:
                        break
                    total_bytes += len(chunk)
            finally:
                response.close()
            logging.warning(
                "Провайдер %s вернул обычный ответ вместо потока: bytes=%d",
                provider_id,
                total_bytes,
            )
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "close")
            self.end_headers()
            self.send_stream_failure()
            self.close_connection = True
            return
        self.send_response(response.status)
        for name in ("Content-Type", "Content-Length", "Retry-After"):
            value = response.headers.get(name)
            if value:
                self.send_header(name, value)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        started_at = time.monotonic()
        pending_event = bytearray()
        terminal_seen = False
        total_bytes = 0
        try:
            while True:
                chunk = response.read(8192)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
                total_bytes += len(chunk)
                if is_stream:
                    terminal_seen = observe_sse_terminal(chunk, pending_event) or terminal_seen
        except (BrokenPipeError, ConnectionResetError):
            logging.warning("Клиент отключился во время ответа.")
        except (http.client.IncompleteRead, urllib.error.URLError, TimeoutError, OSError) as error:
            if not is_stream:
                raise
            logging.error("Поток провайдера %s оборвался: %s", provider_id, error)
            self.send_stream_failure()
        else:
            if is_stream and not terminal_seen:
                logging.warning(
                    "Поток провайдера %s закрылся без события завершения.", provider_id
                )
                self.send_stream_failure()
            if payload.get("stream") is True and not is_stream:
                logging.warning(
                    "Провайдер %s вернул обычный ответ вместо запрошенного потока.",
                    provider_id,
                )
        finally:
            response.close()
            self._diagnostic_response_bytes = total_bytes
            self.close_connection = True
            logging.info(
                "Ответ провайдера %s: status=%s content_type=%s bytes=%d terminal=%s seconds=%.2f",
                provider_id,
                response.status,
                response.headers.get("Content-Type") or "unknown",
                total_bytes,
                "yes" if terminal_seen else "no",
                time.monotonic() - started_at,
            )

    def send_stream_failure(self) -> None:
        """Tell Codex that an already-started upstream SSE stream failed."""
        payload = {
            "type": "response.failed",
            "response": {
                "id": f"resp_proxy_error_{int(time.time() * 1000)}",
                "object": "response",
                "created_at": int(time.time()),
                "status": "failed",
                "completed_at": None,
                "error": {
                    "code": "upstream_stream_error",
                    "message": "Поток ответа провайдера оборвался до завершения.",
                },
            },
        }
        body = (
            "event: response.failed\n"
            f"data: {json.dumps(payload, ensure_ascii=False)}\n\n"
        ).encode("utf-8")
        try:
            self.wfile.write(body)
            self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            logging.warning("Клиент отключился при передаче ошибки потока.")

    def forward_error(self, status: int, body: bytes) -> None:
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)
        self.close_connection = True

    def send_json(self, payload: dict[str, Any], status: int = 200) -> None:
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self._diagnostic_response_bytes = len(body)
        self._diagnostic_response_payload = payload
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)
        self.close_connection = True


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def configure_logging() -> None:
    CODEX_HOME.mkdir(mode=0o700, parents=True, exist_ok=True)
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
        handlers=[logging.FileHandler(LOG_PATH, encoding="utf-8")],
    )


def run(port: int) -> None:
    configure_logging()
    server = Server(("127.0.0.1", port), ProxyHandler)
    logging.info("Proxy listening on 127.0.0.1:%s", port)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


def main() -> None:
    parser = argparse.ArgumentParser(description="Локальный маршрутизатор моделей Codex.")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    arguments = parser.parse_args()
    run(arguments.port)


if __name__ == "__main__":
    main()
